;;; ==========================================================================
;;; 파일명: TSP_5B_DCL_and_Strut.lsp
;;; 구  분: DCL 다이얼로그 UI, 세그먼트 매니저 및 버팀보/앵커/까치발 수동 작도 (Part B)
;;; 역  할: 전체 DCL 생성, 세그먼트 매니저/마법사/대시보드, 지반/범례/벽체/사보강재/지보재 콜백, 수동 버팀보/까치발/연속보강재/앵커편심각/중간말뚝 작도 및 제어 [create-tsp-dcl]
;;; 포함 함수: create-tsp-dcl
;;; --------------------------------------------------------------------------
;;; [안내] 이 파일은 TSP.lsp(메인 로더)에 의해 자동으로 로드되는 하위 모듈입니다.
;;;        코드 수정 시 전체 파일을 합칠 필요 없이 이 파일만 단독 패치하면 됩니다.
;;; ==========================================================================

;;;;==========================================================================
;;;; defun create-tsp-dcl : 임시 DCL 파일을 생성하여 각종 UI 다이얼로그의 형태를 정의하고, 해당 파일의 경로를 반환하는 함수
;;;;==========================================================================
(defun create-tsp-dcl (/ dcl-file dcl-path)
  (setq dcl-path (strcat (getvar "TEMPPREFIX") "tsp.dcl"))
  (setq dcl-file (open dcl-path "w"))
  (if dcl-file
    (progn
      ;; ----------------------------------------------------------------------
      ;; [DCL 0] tsp_main_menu : 초기 시작 메뉴
      ;; ----------------------------------------------------------------------
      (write-line "tsp_main_menu : dialog { label = \"TSP 메인 메뉴\"; " dcl-file)
      (write-line "  : column { alignment = centered; " dcl-file)
      (write-line "    : button { key = \"btn_run\"; label = \"프로젝트 실행 (도면작업)\"; width = 35; } " dcl-file)
      (write-line "    : spacer { height = 0.5; } " dcl-file)
      (write-line "    : button { key = \"btn_load_dwg\"; label = \"도면 내 프로젝트 불러오기\"; width = 35; } " dcl-file)
      (write-line "    : button { key = \"btn_export\"; label = \"EXCEL(CSV)로 내보내기\"; width = 35; } " dcl-file)
      (write-line "    : button { key = \"btn_import\"; label = \"EXCEL(CSV)에서 불러오기\"; width = 35; } " dcl-file)
      (write-line "    : spacer { height = 1.0; } " dcl-file)
      (write-line "    : button { key = \"cancel\"; label = \"종료\"; is_cancel = true; width = 35; } " dcl-file)
      (write-line "  } " dcl-file)
      (write-line "} " dcl-file)

      ;; ----------------------------------------------------------------------
      ;; [DCL 1] tsp_scale : 도면 스케일 설정
      ;; ----------------------------------------------------------------------
      (write-line "tsp_scale : dialog { label = \"스케일 설정\"; " dcl-file)
      (write-line "  : column { alignment = centered; " dcl-file)
      (write-line "    : row { alignment = centered; fixed_width = true; " dcl-file)
      (write-line "      : edit_box { key = \"scale_section\"; label = \"단면도 A3 : 1/\"; edit_width = 3; width = 10; fixed_width = true; } " dcl-file)
      (write-line "    } " dcl-file)
      (write-line "    : row { alignment = centered; fixed_width = true; " dcl-file)
      (write-line "      : edit_box { key = \"scale_plan\"; label = \"평면도 A3 : 1/\"; edit_width = 3; width = 10; fixed_width = true; } " dcl-file)
      (write-line "    } " dcl-file)
      (write-line "  } " dcl-file)
      (write-line "  : spacer { height = 1.0; } " dcl-file)
      (write-line "  : row { alignment = centered; " dcl-file)
      (write-line "    : button { key = \"accept\"; label = \"확인\"; is_default = true; width = 12; } " dcl-file)
      (write-line "    : button { key = \"back\"; label = \"이전\"; width = 12; } " dcl-file)
      (write-line "    : button { key = \"cancel\"; label = \"취소\"; is_cancel = true; width = 12; } " dcl-file)
      (write-line "  } " dcl-file)
      (write-line "} " dcl-file)

      ;; ----------------------------------------------------------------------
      ;; [DCL 2] tsp_load_list : 저장된 프로젝트 관리 및 불러오기
      ;; ----------------------------------------------------------------------
      (write-line "tsp_load_list : dialog { label = \"프로젝트 관리\"; " dcl-file)
      (write-line "  : list_box { key = \"proj_list\"; label = \"저장된 프로젝트:\"; width = 30; height = 10; } " dcl-file)
      (write-line "  : row { alignment = centered; " dcl-file)
      (write-line "    : button { key = \"accept\"; label = \"불러오기\"; is_default = true; } " dcl-file)
      (write-line "    : button { key = \"btn_del_proj\"; label = \"삭제\"; } " dcl-file)
      (write-line "    : button { key = \"cancel\"; label = \"취소\"; is_cancel = true; } " dcl-file)
      (write-line "  } " dcl-file)
      (write-line "} " dcl-file)

      ;; ----------------------------------------------------------------------
      ;; [DCL 3] tsp_save_prompt : 다른 이름으로 프로젝트 저장 확인
      ;; ----------------------------------------------------------------------
      (write-line "tsp_save_prompt : dialog { label = \"프로젝트 저장\"; " dcl-file)
      (write-line "  : text { label = \"다른 이름으로 저장하시겠습니까?\"; alignment = centered; } " dcl-file)
      (write-line "  : spacer { height = 0.5; } " dcl-file)
      (write-line "  : row { alignment = centered; " dcl-file)
      (write-line "    : button { key = \"btn_yes\"; label = \"예 (새로 저장)\"; is_default = true; width = 18; } " dcl-file)
      (write-line "    : button { key = \"btn_no\"; label = \"아니오 (덮어쓰기)\"; width = 18; } " dcl-file)
      (write-line "    : button { key = \"cancel\"; label = \"취소\"; is_cancel = true; width = 12; } " dcl-file)
      (write-line "  } " dcl-file)
      (write-line "} " dcl-file)

      ;; ----------------------------------------------------------------------
      ;; [DCL 3-1] tsp_export_csv_prompt : CSV 내보내기 전 프로젝트 이름 확인/수정 팝업
      ;; ----------------------------------------------------------------------
      (write-line "tsp_export_csv_prompt : dialog { label = \"프로젝트 저장 및 CSV 내보내기\"; " dcl-file)
      (write-line "  : column { " dcl-file)
      (write-line "    : text { label = \"저장 및 내보낼 프로젝트 이름을 확인하세요. (그대로 Enter 시 현재 이름으로 저장)\"; alignment = centered; } " dcl-file)
      (write-line "    : spacer { height = 0.4; } " dcl-file)
      (write-line "    : edit_box { key = \"exp_proj_name\"; label = \"프로젝트 이름:\"; edit_width = 28; allow_accept = true; } " dcl-file)
      (write-line "    : spacer { height = 0.5; } " dcl-file)
      (write-line "    : row { alignment = centered; " dcl-file)
      (write-line "      : button { key = \"accept\"; label = \"확인 (저장 및 내보내기)\"; is_default = true; width = 22; } " dcl-file)
      (write-line "      : button { key = \"cancel\"; label = \"취소\"; is_cancel = true; width = 12; } " dcl-file)
      (write-line "    } " dcl-file)
      (write-line "  } " dcl-file)
      (write-line "} " dcl-file)

     ;; ----------------------------------------------------------------------
      ;; [DCL 4] tsp_section_choice : 단면도 생성 유형 선택 (일반/모서리) 및 서브그룹 선택
      ;; ----------------------------------------------------------------------
      (write-line "tsp_section_choice : dialog { label = \"단면도 생성 선택\"; " dcl-file)
      (write-line "  : column { " dcl-file)
      (write-line "    : text { label = \"작성할 단면도를 선택하세요:\"; alignment = centered; } " dcl-file)
      (write-line "    : spacer { height = 0.5; } " dcl-file)
      (write-line "    : toggle { key = \"chk_seg_sec\"; label = \"세그먼트(일반) 단면도\"; value = \"0\"; } " dcl-file)
      (write-line "    : toggle { key = \"chk_cor_sec\"; label = \"모서리 사보강재(Corner Strut) 단면도\"; value = \"0\"; } " dcl-file)
      (write-line "    : spacer { height = 0.5; } " dcl-file)
      (write-line "    : row { alignment = centered; " dcl-file)
      (write-line "      : button { key = \"accept\"; label = \"확인\"; is_default = true; width = 12; } " dcl-file)
      (write-line "      : button { key = \"cancel\"; label = \"취소\"; is_cancel = true; width = 12; } " dcl-file)
      (write-line "    } " dcl-file)
      (write-line "  } " dcl-file)
      (write-line "} " dcl-file)

      (write-line "tsp_subgrp_choice : dialog { label = \"단면도 기준 버팀보(Sub-group) 선택\"; " dcl-file)
      (write-line "  : column { " dcl-file)
      (write-line "    : text { key = \"subgrp_msg\"; label = \"동일 굴착단계에 여러 Sub-group이 존재합니다.\"; alignment = centered; } " dcl-file)
      (write-line "    : text { label = \"단면도에 작도할 기준 Sub-group을 선택하세요:\"; alignment = centered; } " dcl-file)
      (write-line "    : spacer { height = 0.5; } " dcl-file)
      (write-line "    : list_box { key = \"subgrp_list\"; width = 55; height = 6; } " dcl-file)
      (write-line "    : spacer { height = 0.5; } " dcl-file)
      (write-line "    : row { alignment = centered; " dcl-file)
      (write-line "      : button { key = \"accept\"; label = \"확인\"; is_default = true; width = 12; } " dcl-file)
      (write-line "      : button { key = \"cancel\"; label = \"취소\"; is_cancel = true; width = 12; } " dcl-file)
      (write-line "    } " dcl-file)
      (write-line "  } " dcl-file)
      (write-line "} " dcl-file)

      ;; ----------------------------------------------------------------------
      ;; [DCL 5] tsp_manager : 세그먼트 메인 관리창
      ;; ----------------------------------------------------------------------
      (write-line "tsp_manager : dialog { key = \"manager_title\"; label = \"세그먼트 설정 (Segment Manager)\"; " dcl-file)
      (write-line "  : column { " dcl-file)
      (write-line "    : row { " dcl-file)
      (write-line "      : text { label = \"No.\"; width = 4; } " dcl-file)
      (write-line "      : text { label = \"이름\"; width = 10; } " dcl-file)
      (write-line "      : text { label = \"단면\"; width = 6; } " dcl-file)
      (write-line "      : text { label = \"흙막이벽\"; width = 12; } " dcl-file)
      (write-line "      : text { label = \"H-pile/띠장 규격\"; width = 28; } " dcl-file)
      (write-line "      : text { label = \"지보재\"; width = 15; } " dcl-file)
      (write-line "      : text { label = \"사보강재(Corner Strut)\"; width = 25; } " dcl-file)
      (write-line "    } " dcl-file)
      (write-line (strcat "    : list_box { key = \"seg_list\"; width = 115; height = 15; "
                          "fixed_width = true; fixed_height = true; allow_accept = true; "
                          "multiple_select = true; tabs = \"5 15 21 33 60 75\"; } ") dcl-file)
      (write-line "    : text { key = \"status_msg\"; value = \"목록을 선택하고 입력 버튼을 누르세요.\"; alignment = centered; } " dcl-file)
      (write-line "  } " dcl-file)
      (write-line "  : spacer { height = 0.2; } " dcl-file)
      (write-line "  : row { alignment = centered; " dcl-file)
      (write-line "    : edit_box { key = \"project_name\"; label = \"프로젝트 이름:\"; width = 25; } " dcl-file)
      (write-line "    : button { key = \"btn_load_proj\"; label = \"불러오기\"; width = 12; } " dcl-file)
      (write-line "    : button { key = \"btn_load_csv\"; label = \"CSV 불러오기\"; width = 14; } " dcl-file)
      (write-line "    : button { key = \"btn_export_csv\"; label = \"CSV 내보내기\"; width = 14; } " dcl-file)
      (write-line "    : button { key = \"btn_save_proj\"; label = \"저장\"; width = 12; } " dcl-file)
      (write-line "  } " dcl-file)
      (write-line "  : spacer { height = 0.2; } " dcl-file)
      (write-line "  : row { alignment = centered; " dcl-file)
      (write-line "    : button { key = \"btn_input\"; label = \"입력 (Input)\"; is_default = true; width = 18; } " dcl-file)
      (write-line "    : button { key = \"btn_modify\"; label = \"수정 (Edit)\"; width = 18; } " dcl-file)
      (write-line "    : button { key = \"btn_delete\"; label = \"초기화 (Reset)\"; width = 18; } " dcl-file)
      (write-line "    : button { key = \"btn_copy_from\"; label = \"설정 가져오기\"; width = 22; } " dcl-file)
      (write-line "  } " dcl-file)
      (write-line "  : row { alignment = centered; " dcl-file)
      (write-line "    : button { key = \"btn_apply_all\"; label = \"전체 설정 일괄 적용\"; width = 30; } " dcl-file)
      (write-line "    : button { key = \"btn_delete_all\"; label = \"전체 목록 초기화 (Reset All)\"; width = 30; } " dcl-file)
      (write-line "  } " dcl-file)
      (write-line "  : row { alignment = centered; " dcl-file)
      (write-line "    : button { key = \"btn_apply_soil\"; label = \"지반 정보 복사\"; width = 30; } " dcl-file)
      (write-line "    : button { key = \"btn_apply_support\"; label = \"지보재 정보 복사\"; width = 30; } " dcl-file)
      (write-line "  } " dcl-file)
      (write-line "  : row { alignment = centered; " dcl-file)
      (write-line "    : button { key = \"btn_apply_wall\"; label = \"흙막이벽 정보 복사\"; width = 30; } " dcl-file)
      (write-line "    : button { key = \"btn_apply_brace\"; label = \"사보강재 정보 복사\"; width = 30; } " dcl-file)
      (write-line "  } " dcl-file)
      (write-line "  : spacer { height = 0.5; } " dcl-file)
      (write-line "  : row { alignment = centered; " dcl-file)
      (write-line "    : button { key = \"btn_measure\"; label = \"도면에서 확인/측정 (Measure)\"; width = 30; } " dcl-file)
      (write-line "  } " dcl-file)
      (write-line "  : spacer { height = 1.0; } " dcl-file)
      (write-line "  : row { alignment = centered; " dcl-file)
      (write-line "    : button { key = \"btn_draw_section\"; label = \"단면도 생성 (Section)\"; width = 22; } " dcl-file)
      (write-line "    : button { key = \"btn_draw_plan\"; label = \"평면도 생성 (Plan)\"; width = 22; } " dcl-file)
      (write-line "    : button { key = \"btn_draw_elev\"; label = \"전개도 생성 (Elev)\"; width = 22; } " dcl-file)
      (write-line "    : button { key = \"cancel\"; label = \"종료 (Exit)\"; is_cancel = true; width = 18; } " dcl-file)
      (write-line "  } " dcl-file)
      (write-line "} " dcl-file)

      ;; ----------------------------------------------------------------------
      ;; [DCL 6] tsp_edit_menu : 개별 세그먼트 상세 설정 (지반/흙막이/지보재 등)
      ;; ----------------------------------------------------------------------
      (write-line "tsp_edit_menu : dialog { key = \"menu_title\"; label = \"세그먼트 설정 수정\"; " dcl-file)
      (write-line "  : column { " dcl-file)
      (write-line "    : row { " dcl-file)
      (write-line "      : edit_box { key = \"seg_name\"; label = \"이름 입력 :\"; width = 20; } " dcl-file)
      (write-line "      : toggle { key = \"chk_section\"; label = \"단면생성 (지반 정보 포함)\"; } " dcl-file)
      (write-line "    } " dcl-file)
      (write-line "    : spacer { height = 0.5; } " dcl-file)
      (write-line "    : button { key = \"btn_soil\"; label = \"지반 정의 (Soil)\"; width = 40; fixed_width = true; alignment = centered; } " dcl-file)
      (write-line "    : button { key = \"btn_wall\"; label = \"흙막이벽 정의 (Wall)\"; width = 40; fixed_width = true; alignment = centered; } " dcl-file)
      (write-line "    : button { key = \"btn_support\"; label = \"지보재 정의 (Support)\"; width = 40; fixed_width = true; alignment = centered; } " dcl-file)
      (write-line "    : button { key = \"btn_brace\"; label = \"사보강재(Corner Strut) 정의\"; width = 40; fixed_width = true; alignment = centered; } " dcl-file)
      (write-line "  } " dcl-file)
      (write-line "  : spacer { height = 1; } " dcl-file)
      (write-line "  : row { alignment = centered; " dcl-file)
      (write-line "    : button { key = \"accept\"; label = \"확인 (저장)\"; is_default = true; width = 15; } " dcl-file)
      (write-line "    : button { key = \"cancel\"; label = \"취소\"; is_cancel = true; width = 15; } " dcl-file)
      (write-line "  } " dcl-file)
      (write-line "} " dcl-file)

            ;; ----------------------------------------------------------------------
      ;; [DCL 7-0] tsp_brace_def & tsp_brace_def_single : 사보강재(Corner Strut) 단별 정의(목록) 관리창
      ;; ----------------------------------------------------------------------
      (write-line "tsp_brace_def : dialog { key = \"brace_def_title\"; label = \"사보강재(Corner Strut) 정의 (단별 목록 관리)\"; " dcl-file)
      (write-line "  : column { " dcl-file)
      (write-line "    : text { key = \"brace_def_info\"; label = \"사보강재를 설치깊이 순서대로 추가/복사/수정할 수 있습니다.\"; alignment = centered; } " dcl-file)
      (write-line "    : spacer { height = 0.3; } " dcl-file)
      (write-line "    : list_box { key = \"brace_stage_list\"; label = \"단별 사보강재 목록 (설치깊이 오름차순):\"; width = 78; height = 10; fixed_width = true; fixed_height = true; multiple_select = false; } " dcl-file)
      (write-line "    : spacer { height = 0.4; } " dcl-file)
      (write-line "    : row { alignment = centered; " dcl-file)
      (write-line "      : button { key = \"btn_stage_add\"; label = \"추가\"; width = 14; } " dcl-file)
      (write-line "      : button { key = \"btn_stage_mod\"; label = \"수정\"; width = 14; } " dcl-file)
      (write-line "      : button { key = \"btn_stage_copy\"; label = \"선택 복사 추가\"; width = 18; } " dcl-file)
      (write-line "      : button { key = \"btn_stage_del\"; label = \"삭제\"; width = 14; } " dcl-file)
      (write-line "      : button { key = \"btn_stage_clear\"; label = \"전체삭제\"; width = 14; } " dcl-file)
      (write-line "    } " dcl-file)
      (write-line "    : spacer { height = 0.4; } " dcl-file)
      (write-line "    : boxed_column { label = \"코너부 띠장 상향 (Splice)\"; " dcl-file)
      (write-line "      : row { " dcl-file)
      (write-line "        : toggle { key = \"chk_upgrade_wale\"; label = \"사보강재(Corner Strut) 구간 띠장 상향 적용\"; } " dcl-file)
      (write-line "        : popup_list { key = \"upgrade_wale_spec\"; width = 22; } " dcl-file)
      (write-line "      } " dcl-file)
      (write-line "      : row { alignment = right; " dcl-file)
      (write-line "        : button { key = \"btn_sel_upg_limit\"; label = \"상향 범위(H-pile) 수동 선택\"; width = 26; } " dcl-file)
      (write-line "        : button { key = \"btn_reset_upg_limit\"; label = \"선택 초기화\"; width = 14; } " dcl-file)
      (write-line "      } " dcl-file)
      (write-line "    } " dcl-file)
      (write-line "    : spacer { height = 0.4; } " dcl-file)
      (write-line "    : row { alignment = centered; : button { key = \"btn_measure\"; label = \"도면에서 확인/측정\"; width = 26; } } " dcl-file)
      (write-line "    : spacer { height = 0.4; } " dcl-file)
      (write-line "    : row { alignment = centered; " dcl-file)
      (write-line "      : button { key = \"accept\"; label = \"다음 모서리\"; is_default = true; width = 14; } " dcl-file)
      (write-line "      : button { key = \"btn_comp\"; label = \"완료\"; width = 14; } " dcl-file)
      (write-line "      : button { key = \"cancel\"; label = \"취소\"; is_cancel = true; width = 14; } " dcl-file)
      (write-line "    } " dcl-file)
      (write-line "  } " dcl-file)
      (write-line "} " dcl-file)

      (write-line "tsp_brace_def_single : dialog { key = \"brace_def_title\"; label = \"사보강재(Corner Strut) 정의 (단별 목록 관리)\"; " dcl-file)
      (write-line "  : column { " dcl-file)
